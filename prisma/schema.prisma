// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  displayName  String?     @map("display_name")
  notes        Note[]
  decisions    Decision[]
  auditEntries AuditLog[]
  accounts     Account[]
  sessions     Session[]

  @@map("users")
}

// NextAuth models
model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Strategies & Projects
model Strategy {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  status      String     @default("r_and_d") // "live"|"staging"|"r_and_d"|"paused"
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  trades      Trade[]
  dailyPnl    DailyPnl[]
  projects    Project[]
  notes       Note[]
  decisions   Decision[]

  @@map("strategies")
}

model Project {
  id                  String   @id @default(uuid())
  strategyId          String   @map("strategy_id")
  strategy            Strategy @relation(fields: [strategyId], references: [id])
  repoUrl             String?  @map("repo_url")
  lastBacktestUrl     String?  @map("last_backtest_url")
  runbookUrl          String?  @map("runbook_url")
  readinessScore      Int      @default(0) @map("readiness_score") // 0-100
  readinessBreakdown  Json?    @map("readiness_breakdown") // {risk:n, parity:n, data:n, backtest:n, code:n, ops:n}
  notes               String?
  lastUpdated         DateTime @default(now()) @updatedAt @map("last_updated")

  @@map("projects")
}

// Trading & PnL
model Trade {
  id         Int      @id @default(autoincrement())
  ts         DateTime
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id])
  symbol     String
  side       String // "buy" | "sell"
  qty        Float
  price      Float
  fees       Float    @default(0)
  venue      String?
  tags       String[] @default([])
  extTradeId String   @unique @map("ext_trade_id") // idempotency key

  @@index([ts])
  @@index([strategyId])
  @@index([strategyId, ts])
  @@map("trades")
}

model DailyPnl {
  id         Int      @id @default(autoincrement())
  d          DateTime @db.Date
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id])
  grossPnl   Float    @map("gross_pnl")
  fees       Float    @default(0)
  netPnl     Float    @map("net_pnl") // computed: grossPnl - fees
  dd         Float? // drawdown %
  exposure   Float? // notional or % NAV

  @@unique([d, strategyId])
  @@index([d])
  @@index([strategyId])
  @@map("daily_pnl")
}

// Notes & Decisions
model Note {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  authorId   String   @map("author_id")
  author     User     @relation(fields: [authorId], references: [id])
  scope      String // "day" | "strategy" | "trade"
  scopeRef   String   @map("scope_ref") // date string, strategy_id, or trade_id
  tag        String?  @map("tag")
  attachmentUrl String? @map("attachment_url")
  attachmentPath String? @map("attachment_path")
  content    String
  strategyId String?  @map("strategy_id")
  strategy   Strategy? @relation(fields: [strategyId], references: [id])
  parentNoteId Int?    @map("parent_note_id")
  parent        Note?  @relation("NoteThread", fields: [parentNoteId], references: [id])
  replies       Note[] @relation("NoteThread")

  @@index([createdAt])
  @@map("notes")
}

model Decision {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  decidedBy  String   @map("decided_by")
  decider    User     @relation(fields: [decidedBy], references: [id])
  strategyId String   @map("strategy_id")
  strategy   Strategy @relation(fields: [strategyId], references: [id])
  action     String // "promote"|"pause"|"kill"|"adjust-risk"
  rationale  String

  @@map("decisions")
}

// Audit Log
model AuditLog {
  id       Int      @id @default(autoincrement())
  ts       DateTime @default(now())
  actorId  String   @map("actor_id")
  actor    User     @relation(fields: [actorId], references: [id])
  entity   String // "strategy" | "project" | "decision"
  entityId String   @map("entity_id")
  action   String // "create" | "update" | "delete" | "promote" | etc.
  before   Json?
  after    Json?

  @@map("audit_log")
}
